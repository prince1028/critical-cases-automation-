DATABASE_URL=
SESSION_SECRET=

# New-case email alerts (Resend). Leave RESEND_API_KEY empty to turn alerts off.
RESEND_API_KEY=
# Who gets an email for every new case: comma-separated addresses
CASE_ALERT_EMAILS=
# Sender. onboarding@resend.dev only delivers to your own Resend account email; verify a domain to send to others.
EMAIL_FROM=Florzy Critical Cases <onboarding@resend.dev>
# Public address of the app, used for the "Open the case" link, e.g. https://cases.florzy.com
APP_URL=http://localhost:3000
