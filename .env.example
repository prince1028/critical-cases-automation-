DATABASE_URL=
SESSION_SECRET=

# TEMPORARY - "Critical Cases Analytics" MVP. See README ("Analytics MVP") and src/lib/mvp.ts.
# ANALYTICS_MVP=true shows only Analytics + the WhatsApp importer in the navigation. / and /dashboard
# redirect to /analytics; every other screen, code and route stays exactly where it is.
# Set to false to bring the full product back; nothing has to be changed in code.
ANALYTICS_MVP=true
# While the MVP is on, /analytics and /admin/import-whatsapp also open without signing in, so the
# dashboard and the WhatsApp import can be used internally. Authentication itself is untouched, and
# the screens the MVP hides still require a session.
# Set to false (and remove the line) before this is reachable by anyone else.
ANALYTICS_MVP_BYPASS_AUTH=true

# New-case email alerts, sent from our own mailbox over SMTP. Leave SMTP_PASS empty to turn alerts off.
# Google Workspace / Gmail: SMTP_USER is the full address, SMTP_PASS an app password
# (myaccount.google.com/apppasswords, needs 2-Step Verification). Host/port default to smtp.gmail.com:465.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Who gets an email for every new case: comma-separated addresses
CASE_ALERT_EMAILS=
# Optional display sender; defaults to "Florzy Critical Cases <SMTP_USER>". Gmail only allows SMTP_USER or its aliases.
EMAIL_FROM=
# Public address of the app, used for the "Open the case" link, e.g. https://cases.florzy.com
APP_URL=http://localhost:3000
# Case photos: S3-compatible object storage (Neon object storage on the main branch). Private bucket;
# photos are served only through /api/attachments/[id]. Leave empty to turn photo uploads off.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Item master (Google Sheet, CSV export). Must be shared as "anyone with the link can view". Read live, cached 15 min.
SKU_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/111ZopPXaLQLvIBqHrlwv-mXZuomFbXZbgx0wTS3Kk-k/export?format=csv
