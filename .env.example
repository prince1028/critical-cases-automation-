DATABASE_URL=
SESSION_SECRET=

# New-case email alerts, sent from our own mailbox over SMTP. Leave SMTP_PASS empty to turn alerts off.
# Google Workspace / Gmail: SMTP_USER is the full address, SMTP_PASS an app password
# (myaccount.google.com/apppasswords, needs 2-Step Verification). Host/port default to smtp.gmail.com:465.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Who gets an email for every new case: comma-separated addresses
CASE_ALERT_EMAILS=
# Optional display sender; defaults to "Florzy Critical Cases <SMTP_USER>". Gmail only allows SMTP_USER or its aliases.
EMAIL_FROM=
# Public address of the app, used for the "Open the case" link, e.g. https://cases.florzy.com
APP_URL=http://localhost:3000
